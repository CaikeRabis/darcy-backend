{
  "name": "darcy-backend",
  "version": "1.0.0",
  "description": "DARCY — API Backend · Sistema Inteligente de Orientação Científica",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:e2e": "DARCY_ENV_FILE=.env.e2e.local ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:ai:real": "vitest run --config vitest.real.config.ts",
    "experiment:cnpq:dry-run": "ts-node scripts/run-cnpq-evaluation.ts",
    "test:typecheck": "tsc -p tsconfig.test.json --noEmit",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:e2e:validate": "npm run build && node scripts/run-prisma-e2e.cjs validate",
    "prisma:e2e:migrate:status": "npm run build && node scripts/run-prisma-e2e.cjs migrate status",
    "prisma:e2e:migrate:deploy": "npm run build && node scripts/run-prisma-e2e.cjs migrate deploy"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.117.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "openai": "^7.25.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.5",
    "prisma": "^6.19.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  }
}
