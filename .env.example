# DARCY Backend — Variáveis de Ambiente
# Copie este arquivo para .env e preencha as chaves reais.
# NUNCA faça commit do arquivo .env no repositório.

# ── Provedor de IA ─────────────────────────────────────────────────────────────
AI_PROVIDER=openai

# ── OpenAI API ─────────────────────────────────────────────────────────────────
# Obrigatória quando AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Habilita somente o smoke test real executado pelo comando test:ai:real.
# Mantenha false para que nenhum teste consuma créditos por acidente.
RUN_REAL_AI_TESTS=false

# ── Google Gemini API (alternativa) ────────────────────────────────────────────
# Obrigatória quando AI_PROVIDER=gemini. Obtenha a chave em aistudio.google.com.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# ── Servidor ───────────────────────────────────────────────────────────────────
# PORT é opcional; se ausente, o backend usa 3001.
PORT=3001
NODE_ENV=development

# ── CORS ───────────────────────────────────────────────────────────────────────
# Desenvolvimento: se vazio, usa http://localhost:5174.
# CORS_ORIGIN=http://localhost:5174
# Produção: obrigatório; durante a transição, separe as origens por vírgula.
# CORS_ORIGIN=https://app.darcy.app.br,https://darcy.app.br
CORS_ORIGIN=

# ── Banco de dados (Supabase PostgreSQL + Prisma) ─────────────────────────────
# Obrigatória em runtime pelo Prisma Client. Para ambiente serverless, use a URL
# do Transaction Pooler (porta 6543) do Supabase, com pgbouncer=true.
DATABASE_URL=

# Usada apenas pelo Prisma CLI (migrate, db pull e introspect), não pelo runtime.
# Use a conexão direta (porta 5432) do Supabase; não use o Transaction Pooler.
DIRECT_URL=

# ── Supabase Auth (somente backend) ───────────────────────────────────────────
# Obrigatórias em runtime. URL do projeto e chave pública/publishable usadas para
# validar Bearer JWTs. Não use nem exponha service role key no frontend.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Comma-separated Supabase Auth/profile UUIDs authorized for the admin panel.
# Empty by default; do not use email or user metadata for authorization.
DARCY_ADMIN_PROFILE_IDS=
