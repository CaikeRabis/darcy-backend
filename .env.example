# DARCY Backend — Variáveis de Ambiente
# Copie este arquivo para .env e preencha as chaves reais.
# NUNCA faça commit do arquivo .env no repositório.

# ── Provedor de IA ─────────────────────────────────────────────────────────────
AI_PROVIDER=openai

# ── OpenAI API ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Habilita somente o smoke test real executado pelo comando test:ai:real.
# Mantenha false para que nenhum teste consuma créditos por acidente.
RUN_REAL_AI_TESTS=false

# ── Google Gemini API (rollback) ───────────────────────────────────────────────
# Obtenha sua chave em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# ── Servidor ───────────────────────────────────────────────────────────────────
PORT=
NODE_ENV=

# ── CORS ───────────────────────────────────────────────────────────────────────
# Desenvolvimento: se vazio, usa http://localhost:5174.
# CORS_ORIGIN=http://localhost:5174
# Produção: obrigatório e restrito ao domínio oficial.
# CORS_ORIGIN=https://darcy.app.br
CORS_ORIGIN=

# ── Banco de dados (Supabase PostgreSQL + Prisma) ─────────────────────────────
# Runtime do Prisma Client. Para ambiente serverless, use a URL do Transaction
# Pooler (porta 6543) exibida em Supabase Dashboard > Connect, com pgbouncer=true.
# Em backend persistente, também pode ser usada a URL direta ou do Session Pooler,
# conforme a conectividade IPv4/IPv6 do ambiente de deploy.
DATABASE_URL="postgresql://POOLER_USER:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true"

# Prisma CLI (migrate, db pull e introspect). Use a conexão direta (porta 5432)
# do Supabase Dashboard > Connect; ela não deve apontar para o Transaction Pooler.
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# ── Supabase Auth (somente backend) ───────────────────────────────────────────
# URL do projeto e chave pública/publishable usadas para validar Bearer JWTs.
# Não use nem exponha uma service role key no frontend.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
