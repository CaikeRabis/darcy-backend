generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProjectType {
  artigo
  dissertacao
  tese
  tcc
  projeto_pesquisa @map("projeto-pesquisa")
  resumo_academico @map("resumo-academico")
}

enum ResumoAcademicoEventType {
  rascunho_gerado
  rascunho_regenerado
  secao_aprovada
  decisao_autoral_alterada
  classificacao_cientifica_alterada
  resumo_consolidado
}

enum ResumoAcademicoEventActor {
  pesquisador
  darcy
  sistema
}

enum ResumoAcademicoSection {
  contexto
  objetivo
  metodologia
  fundamentacao_teorica
  resultados
}

/// Origem operacional de uma versão textual. Não constitui atribuição de
/// autoria intelectual; a origem deve ser determinada por operações do
/// servidor em etapas posteriores.
enum ResumoAcademicoTextOrigin {
  ia_assistida
  pesquisador
  restauracao
}

model Profile {
  /// UUID correspondente a auth.users.id, gerenciado pelo Supabase Auth.
  id        String    @id @db.Uuid
  projects  Project[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("profiles")
}

model Project {
  id                      String                   @id @default(cuid())
  profileId               String                   @map("profile_id") @db.Uuid
  title                   String
  field                   String
  type                    ProjectType
  profile                 Profile                  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  resumoAcademicoProgress ResumoAcademicoProgress?
  resumoAcademicoHistory ResumoAcademicoHistoryEvent[]
  resumoAcademicoTextVersions ResumoAcademicoTextVersion[]
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")

  @@index([profileId])
  @@map("projects")
}

model ResumoAcademicoProgress {
  id        String   @id @default(cuid())
  projectId String   @unique @map("project_id")
  progress  Json     @db.JsonB
  revision  Int      @default(0)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("resumo_academico_progress")
}

/// Registro imutável de acontecimentos de domínio do Resumo Acadêmico.
/// O estado atual segue materializado em ResumoAcademicoProgress; textos de
/// versões futuras serão associados por contentVersionRef apenas quando uma
/// versão relevante for criada explicitamente.
model ResumoAcademicoHistoryEvent {
  id                String                     @id @default(cuid())
  projectId         String                     @map("project_id")
  sequence          Int
  type              ResumoAcademicoEventType
  actor             ResumoAcademicoEventActor
  section           ResumoAcademicoSection?
  summary           String
  contentVersionRef String?                    @map("content_version_ref")
  project           Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  textVersion       ResumoAcademicoTextVersion?
  createdAt         DateTime                   @default(now()) @map("created_at")

  @@unique([projectId, sequence])
  @@index([projectId, createdAt])
  @@map("resumo_academico_history_events")
}

/// Snapshot imutável de um texto em marco semântico do Resumo Acadêmico.
/// Não é criado por autosave ou por digitação comum.
model ResumoAcademicoTextVersion {
  id               String                    @id @default(cuid())
  projectId        String                    @map("project_id")
  scopeKey         String                    @map("scope_key")
  section          ResumoAcademicoSection?
  versionNumber    Int                       @map("version_number")
  progressRevision Int                       @map("progress_revision")
  origin           ResumoAcademicoTextOrigin
  content          String                    @db.Text
  contentHash      String                    @map("content_hash") @db.VarChar(64)
  previousVersionId String?                  @map("previous_version_id")
  sourceEventId    String?                   @unique @map("source_event_id")
  project          Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  previousVersion  ResumoAcademicoTextVersion? @relation("ResumoTextVersionLineage", fields: [previousVersionId], references: [id], onDelete: SetNull)
  nextVersions     ResumoAcademicoTextVersion[] @relation("ResumoTextVersionLineage")
  sourceEvent      ResumoAcademicoHistoryEvent? @relation(fields: [sourceEventId], references: [id], onDelete: SetNull)
  createdAt        DateTime                  @default(now()) @map("created_at")

  @@unique([projectId, scopeKey, versionNumber])
  @@index([projectId, scopeKey, createdAt])
  @@index([projectId, progressRevision])
  @@map("resumo_academico_text_versions")
}
