# Copie para .env.e2e.local e preencha somente com dados do projeto Supabase E2E.
# Nunca use valores do Alpha neste arquivo.
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5174

DARCY_E2E_GUARD=enabled
DARCY_E2E_EXPECTED_SUPABASE_PROJECT_REF=
DARCY_ALPHA_SUPABASE_PROJECT_REF=

DATABASE_URL=
DIRECT_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Selecione um único provider e preencha somente a respectiva chave no arquivo local.
AI_PROVIDER=openai
OPENAI_API_KEY=
# OPENAI_MODEL=
# GEMINI_API_KEY=
# GEMINI_MODEL=
